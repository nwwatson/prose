<div id="ai-image-modal-content">
  <div class="rounded-lg bg-red-50 p-3 text-sm text-red-700">
    <%= t('admin.ai.featured_image_error.heading', error: error) %>
  </div>
  <div class="mt-2 flex gap-2">
    <%= button_to t('admin.ai.featured_image_error.try_again'), suggest_prompt_admin_post_ai_featured_image_path(post),
          method: :post,
          class: "rounded-md bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700 hover:bg-gray-200",
          data: { turbo_stream: true } %>
    <button type="button" data-action="click->modal#close"
            class="rounded-md bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700 hover:bg-gray-200">
      <%= t('shared.cancel') %>
    </button>
  </div>
</div>
