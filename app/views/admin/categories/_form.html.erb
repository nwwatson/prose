<%= form_with model: [ :admin, category ], class: "space-y-6" do |f| %>
  <%= render "admin/shared/form_errors", record: category, wrapper_class: "" %>

  <div class="max-w-lg space-y-6">
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-900" %>
      <div class="mt-2">
        <%= f.text_field :name, class: admin_input_classes %>
      </div>
    </div>

    <div>
      <%= f.label :slug, class: "block text-sm font-medium text-gray-900" %>
      <div class="mt-2">
        <%= f.text_field :slug, class: admin_input_classes, placeholder: t('admin.categories.form.slug_placeholder') %>
      </div>
      <p class="mt-1 text-xs text-gray-500"><%= t('admin.categories.form.slug_help') %></p>
    </div>

    <div>
      <%= f.label :description, class: "block text-sm font-medium text-gray-900" %>
      <div class="mt-2">
        <%= f.text_area :description, rows: 3, class: admin_input_classes %>
      </div>
    </div>

    <div>
      <%= f.label :position, class: "block text-sm font-medium text-gray-900" %>
      <div class="mt-2">
        <%= f.number_field :position, class: admin_input_classes %>
      </div>
    </div>

    <div class="flex justify-end space-x-3">
      <%= link_to t('shared.cancel'), admin_categories_path, class: admin_button_classes(variant: :outline) %>
      <%= f.submit class: "#{admin_button_classes(variant: :primary)} cursor-pointer" %>
    </div>
  </div>
<% end %>
