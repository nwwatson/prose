<% content_for(:title, page_title(t('admin.categories.edit.title'))) %>

<div class="space-y-6">
  <%= render "admin/shared/page_header", title: t('admin.categories.edit.title'), stack: false,
        action: button_to(t('shared.delete'), admin_category_path(@category), method: :delete, data: { turbo_confirm: t('shared.are_you_sure') }, class: admin_button_classes(variant: :danger)) %>
  <%= render "form", category: @category %>
</div>
