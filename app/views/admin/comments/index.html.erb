<% content_for(:title, page_title(t('admin.comments.index.title'))) %>

<div class="space-y-6">
  <h1 class="text-2xl font-bold text-gray-900"><%= t('admin.comments.index.title') %></h1>

  <div class="border-b border-gray-200">
    <nav class="-mb-px flex space-x-4 overflow-x-auto sm:space-x-8">
      <%= admin_tab_link t('shared.all'), admin_comments_path, active: params[:filter].blank? %>
      <%= admin_tab_link t('shared.pending'), admin_comments_path(filter: "pending"), active: params[:filter] == 'pending' %>
      <%= admin_tab_link t('admin.comments.index.approved'), admin_comments_path(filter: "approved"), active: params[:filter] == 'approved' %>
    </nav>
  </div>

  <% if @comments.load.any? %>
    <div class="space-y-4">
      <%= render partial: "comment", collection: @comments, as: :comment %>
    </div>
  <% else %>
    <%= render "admin/shared/empty_state", description: t('admin.comments.index.no_comments') %>
  <% end %>

  <%= render "admin/shared/pagination", page: @page, next_page: @next_page %>
</div>
