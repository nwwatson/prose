<% content_for(:title, page_title(t('admin.dashboard.show.title'))) %>

<div>
  <h1 class="text-2xl font-bold text-gray-900"><%= t('admin.dashboard.show.title') %></h1>
  <p class="mt-2 text-sm text-gray-600"><%= t('admin.dashboard.show.welcome_back', name: current_user.display_name) %></p>
</div>

<div class="mt-8 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-5">
  <%= render "admin/shared/stat_card", label: t('admin.dashboard.show.total_subscribers'), value: @total_subscribers, trend: @subscriber_trend %>

  <%= render "admin/shared/stat_card", label: t('admin.dashboard.show.new_subscribers_30d'), value: @new_subscribers_30d %>

  <%= render "admin/shared/stat_card", label: t('admin.dashboard.show.total_views_30d'), value: @total_views_30d, trend: @views_trend %>

  <%= render "admin/shared/stat_card", label: t('admin.dashboard.show.published_posts'), value: @published_posts_count %>

  <%= render "admin/shared/stat_card", label: t('admin.dashboard.show.newsletters_sent_30d'), value: @newsletters_sent_30d,
             wrapper_class: "col-span-2 sm:col-span-1 lg:col-span-1" %>
</div>

<div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-2">
  <%= render "admin/shared/panel", title: t('admin.dashboard.show.views_last_30_days') do %>
    <div class="w-full" data-controller="chart" data-chart-target="canvas" data-chart-data-value="<%= @views_by_day.to_json %>" style="height: 200px;"></div>
    <% if @views_by_day.empty? %>
      <p class="mt-4 text-sm text-gray-500"><%= t('admin.dashboard.show.no_view_data') %></p>
    <% end %>
  <% end %>

  <%= render "admin/shared/panel", title: t('admin.dashboard.show.subscriber_growth_30d') do %>
    <div class="w-full" data-controller="chart" data-chart-target="canvas" data-chart-data-value="<%= @subscriber_growth.to_json %>" style="height: 200px;"></div>
    <% if @subscriber_growth.empty? %>
      <p class="mt-4 text-sm text-gray-500"><%= t('admin.dashboard.show.no_subscriber_data') %></p>
    <% end %>
  <% end %>
</div>

<div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-2">
  <%# Traffic Sources Summary %>
  <%= render "admin/shared/panel", title: t('admin.dashboard.show.traffic_sources'),
             action: link_to(t('admin.dashboard.show.view_details'), admin_traffic_path, class: "text-sm text-blue-600 hover:text-blue-800") do %>
    <%= render "admin/shared/bar_list", counts: @traffic_sources, limit: 5, empty: t('admin.dashboard.show.no_traffic_data') %>
  <% end %>

  <%# Top Engaged Posts %>
  <%= render "admin/shared/panel", title: t('admin.dashboard.show.top_engaged_posts') do %>
    <%= render "admin/shared/count_table",
               headers: [ t('admin.dashboard.show.post'), t('admin.dashboard.show.views'), t('admin.dashboard.show.loves') ],
               rows: @top_engaged_posts.map { |post| [ link_to(post.title, admin_post_dashboard_path(post), class: "hover:text-indigo-600"), post.views_count, post.loves_count ] },
               empty: t('admin.dashboard.show.no_views_recorded') %>
  <% end %>
</div>

<div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-2">
  <%= render "admin/shared/panel", title: t('admin.dashboard.show.top_posts_30d') do %>
    <%= render "admin/shared/count_table",
               headers: [ t('admin.dashboard.show.post'), t('admin.dashboard.show.views') ],
               rows: @top_posts.map { |post| [ link_to(post.title, admin_post_dashboard_path(post), class: "hover:text-indigo-600"), post.views_count ] },
               empty: t('admin.dashboard.show.no_views_recorded') %>
  <% end %>

  <%= render "admin/shared/panel", title: t('admin.dashboard.show.recent_posts') do %>
    <% if @recent_posts.any? %>
      <div class="space-y-3">
        <% @recent_posts.each do |post| %>
          <div class="flex items-center justify-between">
            <div class="min-w-0 flex-1">
              <p class="text-sm font-medium text-gray-900 truncate"><%= link_to post.title, edit_admin_post_path(post), class: "hover:text-indigo-600" %></p>
              <p class="text-xs text-gray-500"><%= post.published_at ? l(post.published_at.to_date, format: :short) : nil %> · <%= post.user.display_name %></p>
            </div>
            <div class="ml-3 flex-shrink-0 text-sm text-gray-500"><%= post.loves_count %> <%= t('admin.dashboard.show.loves') %></div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500"><%= t('admin.dashboard.show.no_published_posts') %></p>
    <% end %>
  <% end %>
</div>

<%# Subscriber Acquisition & Recent Newsletters %>
<div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-2">
  <%= render "admin/shared/panel", title: t('admin.dashboard.show.subscriber_acquisition') do %>
    <% if @acquisition_channels.any? %>
      <div class="space-y-3">
        <% @acquisition_channels.each do |channel, count| %>
          <div class="flex justify-between text-sm">
            <span class="font-medium text-gray-700 capitalize"><%= channel == "post" ? t('admin.dashboard.show.from_posts') : t('admin.dashboard.show.direct_signup') %></span>
            <span class="text-gray-500"><%= count %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500"><%= t('admin.dashboard.show.no_subscriber_data') %></p>
    <% end %>
  <% end %>

  <%= render "admin/shared/panel", title: t('admin.dashboard.show.recent_newsletters') do %>
    <%= render "admin/shared/count_table",
               headers: [ t('admin.dashboard.show.newsletter'), t('admin.dashboard.show.recipients'), t('shared.sent') ],
               rows: @recent_newsletters.map { |newsletter| [ link_to(newsletter.title, admin_newsletter_path(newsletter), class: "hover:text-indigo-600"),
                                                              newsletter.recipients_count,
                                                              newsletter.sent_at ? l(newsletter.sent_at.to_date, format: :short) : nil ] },
               empty: t('admin.dashboard.show.no_newsletters_sent') %>
  <% end %>
</div>
