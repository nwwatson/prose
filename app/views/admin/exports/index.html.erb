<% content_for(:title, "#{t('admin.exports.index.title')} — #{site_name}") %>
<%= turbo_stream_from "exports" %>

<div class="space-y-6">
  <%= render "admin/shared/page_header", title: t('admin.exports.index.title') %>

  <p class="text-sm text-gray-600"><%= t('admin.exports.index.subtitle') %></p>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="rounded-lg border border-gray-200 bg-white p-5">
      <h2 class="text-sm font-semibold text-gray-900"><%= t('admin.exports.index.markdown_title') %></h2>
      <p class="mt-1 text-sm text-gray-500"><%= t('admin.exports.index.markdown_description') %></p>
      <%= button_to t('admin.exports.index.export_markdown'), admin_exports_path, params: { format_type: "markdown" },
            class: admin_button_classes(variant: :primary, extra: "mt-4") %>
    </div>

    <div class="rounded-lg border border-gray-200 bg-white p-5">
      <h2 class="text-sm font-semibold text-gray-900"><%= t('admin.exports.index.json_title') %></h2>
      <p class="mt-1 text-sm text-gray-500"><%= t('admin.exports.index.json_description') %></p>
      <%= button_to t('admin.exports.index.export_json'), admin_exports_path, params: { format_type: "json" },
            class: admin_button_classes(variant: :primary, extra: "mt-4") %>
    </div>
  </div>

  <div>
    <h2 class="text-lg font-semibold text-gray-900"><%= t('admin.exports.index.recent_exports') %></h2>

    <% if @exports.any? %>
      <ul class="mt-3 divide-y divide-gray-200 overflow-hidden rounded-lg border border-gray-200 bg-white">
        <%= render partial: "admin/exports/export", collection: @exports %>
      </ul>
    <% else %>
      <div class="mt-3">
        <%= render "admin/shared/empty_state", description: t('admin.exports.index.no_exports') %>
      </div>
    <% end %>
  </div>
</div>
