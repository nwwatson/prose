<% content_for(:title, "Growth — #{site_name}") %>

<div>
  <h1 class="text-2xl font-bold text-gray-900"><%= t('admin.growth.show.title') %></h1>
  <p class="mt-2 text-sm text-gray-600"><%= t('admin.growth.show.subtitle') %></p>
</div>

<%# Stat Cards %>
<div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-3 sm:gap-5">
  <div class="bg-white overflow-hidden shadow rounded-lg">
    <div class="p-4 sm:p-5">
      <div class="text-sm font-medium text-gray-500 truncate"><%= t('admin.growth.show.total_subscribers') %></div>
      <div class="mt-1 text-2xl font-semibold text-gray-900 sm:text-3xl"><%= @total_subscribers %></div>
    </div>
  </div>

  <div class="bg-white overflow-hidden shadow rounded-lg">
    <div class="p-4 sm:p-5">
      <div class="text-sm font-medium text-gray-500 truncate"><%= t('admin.growth.show.new_subscribers', range: @range) %></div>
      <div class="mt-1 text-2xl font-semibold text-gray-900 sm:text-3xl"><%= @new_subscribers %></div>
    </div>
  </div>

  <div class="bg-white overflow-hidden shadow rounded-lg">
    <div class="p-4 sm:p-5">
      <div class="text-sm font-medium text-gray-500 truncate"><%= t('admin.growth.show.latest_post_subscribers') %></div>
      <% if @latest_post_data %>
        <div class="mt-1 text-2xl font-semibold text-gray-900 sm:text-3xl"><%= @latest_post_data[:count] %></div>
        <p class="mt-1 text-xs text-gray-500 truncate"><%= @latest_post_data[:post].title %></p>
      <% else %>
        <div class="mt-1 text-2xl font-semibold text-gray-900 sm:text-3xl">—</div>
      <% end %>
    </div>
  </div>
</div>

<%# Bar Chart %>
<div class="mt-8 bg-white shadow rounded-lg p-4 sm:p-6"
     data-controller="growth-chart"
     data-growth-chart-monthly-value="<%= @monthly_data.to_json %>"
     data-growth-chart-cumulative-value="<%= @cumulative_data.to_json %>"
     data-growth-chart-active-class="bg-blue-600 text-white hover:bg-blue-700"
     data-growth-chart-inactive-class="bg-white text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50">

  <div class="flex flex-col gap-4 mb-6 sm:flex-row sm:items-center sm:justify-between">
    <h2 class="text-lg font-medium text-gray-900"><%= t('admin.growth.show.subscriber_growth') %></h2>

    <div class="flex flex-wrap items-center gap-3">
      <%# Chart mode toggle %>
      <div class="inline-flex rounded-md shadow-sm">
        <button type="button"
                data-growth-chart-target="monthlyBtn"
                data-action="growth-chart#showMonthly"
                class="rounded-l-md bg-blue-600 px-3 py-2 text-xs font-medium text-white hover:bg-blue-700 sm:py-1.5">
          <%= t('admin.growth.show.monthly') %>
        </button>
        <button type="button"
                data-growth-chart-target="cumulativeBtn"
                data-action="growth-chart#showCumulative"
                class="-ml-px rounded-r-md bg-white px-3 py-2 text-xs font-medium text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:py-1.5">
          <%= t('admin.growth.show.cumulative') %>
        </button>
      </div>

      <%# Time range links %>
      <%= render "admin/shared/range_selector",
            ranges: Admin::GrowthController::ALLOWED_RANGES,
            current: @range,
            path: ->(range) { admin_growth_path(range: range) } %>
    </div>
  </div>

  <div data-growth-chart-target="canvas" class="w-full min-h-[200px]" style="height: 300px;"></div>

  <% if @monthly_data.empty? %>
    <p class="mt-4 text-sm text-gray-500 text-center"><%= t('admin.growth.show.no_data') %></p>
  <% end %>
</div>

<%# Top Posts by Subscribers %>
<div class="mt-8 bg-white shadow rounded-lg p-4 sm:p-6">
  <h2 class="text-lg font-medium text-gray-900 mb-4"><%= t('admin.growth.show.top_posts_by_subscribers') %></h2>
  <% if @top_posts.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead>
          <tr>
            <th class="text-left text-xs font-medium text-gray-500 uppercase pb-2"><%= t('admin.growth.show.post') %></th>
            <th class="text-right text-xs font-medium text-gray-500 uppercase pb-2"><%= t('admin.growth.show.subscribers') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @top_posts.each do |post| %>
            <tr>
              <td class="py-2 text-sm text-gray-900">
                <%= link_to post.title, admin_post_dashboard_path(post), class: "hover:text-blue-600" %>
              </td>
              <td class="py-2 text-sm text-gray-500 text-right"><%= post.subscribers_count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-sm text-gray-500"><%= t('admin.growth.show.no_post_subscribers') %></p>
  <% end %>
</div>
