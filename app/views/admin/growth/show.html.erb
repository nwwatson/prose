<% content_for(:title, page_title(t('layouts.admin.growth'))) %>

<div>
  <h1 class="text-2xl font-bold text-gray-900"><%= t('admin.growth.show.title') %></h1>
  <p class="mt-2 text-sm text-gray-600"><%= t('admin.growth.show.subtitle') %></p>
</div>

<%# Stat Cards %>
<div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-3 sm:gap-5">
  <%= render "admin/shared/stat_card", label: t('admin.growth.show.total_subscribers'), value: @total_subscribers %>

  <%= render "admin/shared/stat_card", label: t('admin.growth.show.new_subscribers', range: @range), value: @new_subscribers %>

  <%= render "admin/shared/stat_card", label: t('admin.growth.show.latest_post_subscribers'),
             value: @latest_post_data ? @latest_post_data[:count] : "—", note: @latest_post_data&.dig(:post)&.title %>
</div>

<%# Bar Chart %>
<% chart_controls = capture do %>
  <div class="flex flex-wrap items-center gap-3">
    <%# Chart mode toggle %>
    <div class="inline-flex rounded-md shadow-sm">
      <button type="button"
              data-growth-chart-target="monthlyBtn"
              data-action="growth-chart#showMonthly"
              class="rounded-l-md bg-blue-600 px-3 py-2 text-xs font-medium text-white hover:bg-blue-700 sm:py-1.5">
        <%= t('admin.growth.show.monthly') %>
      </button>
      <button type="button"
              data-growth-chart-target="cumulativeBtn"
              data-action="growth-chart#showCumulative"
              class="-ml-px rounded-r-md bg-white px-3 py-2 text-xs font-medium text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:py-1.5">
        <%= t('admin.growth.show.cumulative') %>
      </button>
    </div>

    <%# Time range links %>
    <%= render "admin/shared/range_selector",
          ranges: Admin::GrowthController::ALLOWED_RANGES,
          current: @range,
          path: ->(range) { admin_growth_path(range: range) } %>
  </div>
<% end %>
<%= render "admin/shared/panel", title: t('admin.growth.show.subscriber_growth'), action: chart_controls, stack: true, wrapper_class: "mt-8",
           data: { controller: "growth-chart",
                   growth_chart_monthly_value: @monthly_data.to_json,
                   growth_chart_cumulative_value: @cumulative_data.to_json,
                   growth_chart_active_class: "bg-blue-600 text-white hover:bg-blue-700",
                   growth_chart_inactive_class: "bg-white text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" } do %>
  <div data-growth-chart-target="canvas" class="w-full min-h-[200px]" style="height: 300px;"></div>

  <% if @monthly_data.empty? %>
    <p class="mt-4 text-sm text-gray-500 text-center"><%= t('admin.growth.show.no_data') %></p>
  <% end %>
<% end %>

<%# Top Posts by Subscribers %>
<%= render "admin/shared/panel", title: t('admin.growth.show.top_posts_by_subscribers'), wrapper_class: "mt-8" do %>
  <%= render "admin/shared/count_table",
             headers: [ t('admin.growth.show.post'), t('admin.growth.show.subscribers') ],
             rows: @top_posts.map { |post| [ link_to(post.title, admin_post_dashboard_path(post), class: "hover:text-blue-600"), post.subscribers_count ] },
             empty: t('admin.growth.show.no_post_subscribers') %>
<% end %>
