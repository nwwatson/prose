<% content_for(:title, "#{t('admin.imports.index.title')} — #{site_name}") %>
<%= turbo_stream_from "imports" %>

<div class="space-y-6">
  <%= render "admin/shared/page_header", title: t('admin.imports.index.title') %>
  <%= render "admin/shared/import_export_tabs", current: :imports %>

  <div class="rounded-lg border border-gray-200 bg-white p-5">
    <h2 class="text-sm font-semibold text-gray-900"><%= t('admin.imports.index.wordpress_title') %></h2>
    <p class="mt-1 text-sm text-gray-500"><%= t('admin.imports.index.wordpress_description') %></p>

    <%= form_with model: @import, url: admin_imports_path, class: "mt-4 space-y-4" do |f| %>
      <%= render "admin/shared/form_errors", record: @import, wrapper_class: "" %>
      <%= f.hidden_field :source, value: "wordpress" %>
      <div>
        <%= f.label :file, t('admin.imports.index.file_label'), class: "block text-sm font-medium text-gray-900" %>
        <%= f.file_field :file, accept: ".xml,application/xml,text/xml", required: true,
              class: "mt-2 block w-full text-sm text-gray-700 file:mr-3 file:rounded-md file:border-0 file:bg-gray-100 file:px-3 file:py-2 file:text-sm file:font-medium file:text-gray-900 hover:file:bg-gray-200" %>
        <p class="mt-1 text-xs text-gray-500"><%= t('admin.imports.index.file_hint', size: number_to_human_size(Import::MAX_FILE_SIZE)) %></p>
      </div>
      <%= f.submit t('admin.imports.index.start_import'), class: admin_button_classes(variant: :primary) %>
    <% end %>
  </div>

  <div>
    <h2 class="text-lg font-semibold text-gray-900"><%= t('admin.imports.index.recent_imports') %></h2>

    <% if @imports.any? %>
      <ul class="mt-3 divide-y divide-gray-200 overflow-hidden rounded-lg border border-gray-200 bg-white">
        <%= render partial: "admin/imports/import", collection: @imports %>
      </ul>
    <% else %>
      <div class="mt-3">
        <%= render "admin/shared/empty_state", description: t('admin.imports.index.no_imports') %>
      </div>
    <% end %>
  </div>
</div>
