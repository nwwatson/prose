<%# locals: (list:) %>
<% if list.active? %>
  <%= status_badge t('admin.mailing_lists.badges.active'), color_class: "bg-green-100 text-green-800", size: :sm %>
<% else %>
  <%= status_badge t('admin.mailing_lists.badges.inactive'), color_class: "bg-gray-100 text-gray-700", size: :sm %>
<% end %>
<% if list.subscribe_by_default? %>
  <%= status_badge t('admin.mailing_lists.badges.default'), color_class: "bg-blue-100 text-blue-800", size: :sm %>
<% end %>
