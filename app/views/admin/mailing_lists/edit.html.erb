<% content_for(:title, "#{t('admin.mailing_lists.edit.title')} — #{site_name}") %>

<div class="space-y-6">
  <%= render "admin/shared/page_header", title: t('admin.mailing_lists.edit.title'), stack: false,
        action: button_to(t('shared.delete'), admin_mailing_list_path(@mailing_list), method: :delete, data: { turbo_confirm: t('admin.mailing_lists.edit.delete_confirm') }, class: admin_button_classes(variant: :danger)) %>
  <%= render "form", mailing_list: @mailing_list %>
</div>
