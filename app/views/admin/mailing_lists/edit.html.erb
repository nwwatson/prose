<% content_for(:title, "#{t('admin.mailing_lists.edit.title')} — #{site_name}") %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900"><%= t('admin.mailing_lists.edit.title') %></h1>
    <%= button_to t('shared.delete'), admin_mailing_list_path(@mailing_list), method: :delete, data: { turbo_confirm: t('admin.mailing_lists.edit.delete_confirm') }, class: "rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500" %>
  </div>
  <%= render "form", mailing_list: @mailing_list %>
</div>
