<% content_for(:title, "#{t('admin.membership_tiers.index.title')} — #{site_name}") %>

<% if @tiers.any? { |tier| !tier.synced_to_stripe? } %>
  <%= turbo_stream_from "membership_tiers" %>
<% end %>

<div class="space-y-6">
  <%= render "admin/shared/page_header", title: t('admin.membership_tiers.index.title'),
        action: link_to(t('admin.membership_tiers.index.new_tier'), new_admin_membership_tier_path, class: admin_button_classes(variant: :primary, extra: "self-start")) %>

  <% if @tiers.any? %>
    <%# Mobile card layout %>
    <div class="space-y-3 lg:hidden">
      <% @tiers.each do |tier| %>
        <%= render "tier_card", tier: tier, member_count: @member_counts.fetch(tier.id, 0) %>
      <% end %>
    </div>

    <%# Desktop table layout %>
    <div class="hidden overflow-hidden bg-white shadow ring-1 ring-gray-200 sm:rounded-lg lg:block">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="<%= admin_th_classes %>"><%= t('admin.membership_tiers.index.name') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.membership_tiers.index.price') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.membership_tiers.index.interval') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.membership_tiers.index.status') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.membership_tiers.index.members') %></th>
            <th class="relative px-6 py-3"><span class="sr-only"><%= t('shared.actions') %></span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% @tiers.each do |tier| %>
            <%= render "tier_row", tier: tier, member_count: @member_counts.fetch(tier.id, 0) %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "admin/shared/empty_state", title: t('admin.membership_tiers.index.no_tiers'), description: t('admin.membership_tiers.index.get_started'),
          action_label: t('admin.membership_tiers.index.new_tier'), action_path: new_admin_membership_tier_path %>
  <% end %>
</div>
