<% content_for(:title, "#{t('admin.membership_tiers.index.title')} — #{site_name}") %>

<div class="space-y-6">
  <%= render "admin/shared/page_header", title: t('admin.membership_tiers.index.title'),
        action: link_to(t('admin.membership_tiers.index.new_tier'), new_admin_membership_tier_path, class: admin_button_classes(variant: :primary, extra: "self-start")) %>

  <% if @tiers.any? %>
    <%# Mobile card layout %>
    <div class="space-y-3 lg:hidden">
      <% @tiers.each do |tier| %>
        <%= link_to edit_admin_membership_tier_path(tier), class: "block rounded-lg bg-white p-4 shadow ring-1 ring-gray-200" do %>
          <div class="flex items-center justify-between">
            <span class="text-sm font-medium text-gray-900"><%= tier.name %></span>
            <span class="text-sm font-semibold text-gray-900"><%= tier.formatted_price %><%= tier.interval_label %></span>
          </div>
          <div class="mt-1 flex items-center gap-2">
            <%= status_badge(tier.active? ? t('shared.active') : t('admin.membership_tiers.index.inactive'),
                  color_class: tier.active? ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800', size: :sm) %>
            <span class="text-xs text-gray-500"><%= @member_counts.fetch(tier.id, 0) %> <%= t('admin.membership_tiers.index.members') %></span>
          </div>
        <% end %>
      <% end %>
    </div>

    <%# Desktop table layout %>
    <div class="hidden overflow-hidden bg-white shadow ring-1 ring-gray-200 sm:rounded-lg lg:block">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="<%= admin_th_classes %>"><%= t('admin.membership_tiers.index.name') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.membership_tiers.index.price') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.membership_tiers.index.interval') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.membership_tiers.index.status') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.membership_tiers.index.members') %></th>
            <th class="relative px-6 py-3"><span class="sr-only"><%= t('shared.actions') %></span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% @tiers.each do |tier| %>
            <tr>
              <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= tier.name %></td>
              <td class="px-6 py-4 text-sm text-gray-500"><%= tier.formatted_price %></td>
              <td class="px-6 py-4 text-sm text-gray-500"><%= tier.interval.capitalize %></td>
              <td class="px-6 py-4 text-sm">
                <%= status_badge(tier.active? ? t('shared.active') : t('admin.membership_tiers.index.inactive'),
                      color_class: tier.active? ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800', size: :sm) %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-500"><%= @member_counts.fetch(tier.id, 0) %></td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                <%= link_to t('shared.edit'), edit_admin_membership_tier_path(tier), class: "text-gray-600 hover:text-gray-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "admin/shared/empty_state", title: t('admin.membership_tiers.index.no_tiers'), description: t('admin.membership_tiers.index.get_started'),
          action_label: t('admin.membership_tiers.index.new_tier'), action_path: new_admin_membership_tier_path %>
  <% end %>
</div>
