<%# locals: (location:, items:, new_item:) %>
<section id="<%= location %>" class="rounded-lg bg-white shadow ring-1 ring-gray-200">
  <div class="border-b border-gray-200 px-6 py-4">
    <h2 class="text-base font-semibold text-gray-900"><%= t("admin.navigation_items.locations.#{location}.title") %></h2>
    <p class="mt-1 text-sm text-gray-500"><%= t("admin.navigation_items.locations.#{location}.description") %></p>
  </div>

  <% if items.any? %>
    <ul class="divide-y divide-gray-200"
        data-controller="sortable"
        data-sortable-url-value="<%= reorder_admin_navigation_items_path %>"
        data-sortable-location-value="<%= location %>"
        data-sortable-dragging-class="opacity-50 bg-gray-50"
        data-action="dragover->sortable#over drop->sortable#drop">
      <%= render partial: "item", collection: items %>
    </ul>
  <% else %>
    <p class="px-6 py-6 text-sm text-gray-500"><%= t("admin.navigation_items.index.empty") %></p>
  <% end %>

  <div class="border-t border-gray-200 bg-gray-50 px-6 py-4 sm:rounded-b-lg">
    <h3 class="text-sm font-medium text-gray-900"><%= t("admin.navigation_items.index.add_item") %></h3>
    <%= render "form", item: new_item, inline: true %>
  </div>
</section>
