<% content_for(:title, "Newsletters — #{site_name}") %>

<div class="space-y-6">
  <%= render "admin/shared/page_header", title: t('admin.newsletters.index.title'),
        action: link_to(t('admin.newsletters.index.new_newsletter'), new_admin_newsletter_path, class: admin_button_classes(variant: :primary, extra: "self-start")) %>

  <%# Status tabs %>
  <div class="border-b border-gray-200">
    <nav class="-mb-px flex space-x-4 overflow-x-auto sm:space-x-8">
      <%= link_to t('shared.all'), admin_newsletters_path, class: "whitespace-nowrap border-b-2 #{params[:status].blank? ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'} px-1 pb-4 text-sm font-medium" %>
      <%= link_to t('shared.sent'), admin_newsletters_path(status: "sent"), class: "whitespace-nowrap border-b-2 #{params[:status] == 'sent' ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'} px-1 pb-4 text-sm font-medium" %>
      <%= link_to t('shared.scheduled'), admin_newsletters_path(status: "scheduled"), class: "whitespace-nowrap border-b-2 #{params[:status] == 'scheduled' ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'} px-1 pb-4 text-sm font-medium" %>
      <%= link_to t('shared.drafts'), admin_newsletters_path(status: "draft"), class: "whitespace-nowrap border-b-2 #{params[:status] == 'draft' ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'} px-1 pb-4 text-sm font-medium" %>
    </nav>
  </div>

  <%# Newsletter list %>
  <% if @newsletters.any? %>
    <%# Mobile card layout %>
    <div class="space-y-3 lg:hidden">
      <% @newsletters.each do |newsletter| %>
        <%= link_to edit_admin_newsletter_path(newsletter), class: "block rounded-lg bg-white p-4 shadow ring-1 ring-gray-200" do %>
          <div class="flex items-start justify-between gap-3">
            <p class="min-w-0 text-sm font-medium text-gray-900"><%= newsletter.title %></p>
            <%= status_badge(newsletter.status.capitalize, color_class: "flex-shrink-0 #{newsletter_status_color(newsletter.status)}") %>
          </div>
          <div class="mt-2 flex items-center gap-3 text-xs text-gray-500">
            <% if newsletter.sent? %>
              <span><%= newsletter.recipients_count %> <%= t('admin.newsletters.index.recipients').downcase %></span>
              <span>&middot;</span>
            <% end %>
            <span><%= newsletter.sent_at&.strftime("%b %-d, %Y") || newsletter.updated_at.strftime("%b %-d, %Y") %></span>
          </div>
        <% end %>
      <% end %>
    </div>

    <%# Desktop table layout %>
    <div class="hidden overflow-hidden bg-white shadow ring-1 ring-gray-200 sm:rounded-lg lg:block">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="<%= admin_th_classes %>"><%= t('admin.newsletters.index.title_header') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.newsletters.index.status') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.newsletters.index.recipients') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.newsletters.index.date') %></th>
            <th class="relative px-6 py-3"><span class="sr-only"><%= t('shared.actions') %></span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% @newsletters.each do |newsletter| %>
            <tr>
              <td class="px-6 py-4">
                <%= link_to newsletter.title, edit_admin_newsletter_path(newsletter), class: "text-sm font-medium text-gray-900 hover:text-gray-600" %>
              </td>
              <td class="whitespace-nowrap px-6 py-4">
                <%= status_badge(newsletter.status.capitalize, color_class: newsletter_status_color(newsletter.status)) %>
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                <%= newsletter.sent? ? newsletter.recipients_count : "—" %>
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                <%= newsletter.sent_at&.strftime("%b %-d, %Y") || newsletter.updated_at.strftime("%b %-d, %Y") %>
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                <%= link_to t('shared.edit'), edit_admin_newsletter_path(newsletter), class: "text-gray-600 hover:text-gray-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "admin/shared/empty_state", title: t('admin.newsletters.index.no_newsletters'), description: t('admin.newsletters.index.get_started'),
          action_label: t('admin.newsletters.index.new_newsletter'), action_path: new_admin_newsletter_path %>
  <% end %>
</div>
