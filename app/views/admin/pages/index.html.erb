<% content_for(:title, "Pages — #{site_name}") %>

<div class="space-y-6">
  <%= render "admin/shared/page_header", title: t("admin.pages.index.title"),
        action: link_to(t("admin.pages.index.new_page"), new_admin_page_path, class: admin_button_classes(variant: :primary, extra: "self-start")) %>

  <% if @pages.any? %>
    <%# Mobile card layout %>
    <div class="space-y-3 lg:hidden">
      <% @pages.each do |page| %>
        <%= link_to edit_admin_page_path(page), class: "block rounded-lg bg-white p-4 shadow ring-1 ring-gray-200" do %>
          <div class="flex items-start justify-between gap-3">
            <p class="min-w-0 text-sm font-medium text-gray-900"><%= page.title %></p>
            <%= status_badge(page.status.capitalize, color_class: "flex-shrink-0 #{page.published? ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}") %>
          </div>
          <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-gray-500">
            <span class="font-mono">/<%= page.slug %></span>
            <% if page.show_in_navigation? %>
              <span class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-800"><%= t("admin.pages.index.in_nav") %></span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <%# Desktop table layout %>
    <div class="hidden overflow-hidden bg-white shadow ring-1 ring-gray-200 sm:rounded-lg lg:block">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="<%= admin_th_classes %>"><%= t("admin.pages.index.title_header") %></th>
            <th class="<%= admin_th_classes %>"><%= t("admin.pages.index.status") %></th>
            <th class="<%= admin_th_classes %>"><%= t("admin.pages.index.nav") %></th>
            <th class="<%= admin_th_classes %>"><%= t("admin.pages.index.slug") %></th>
            <th class="relative px-6 py-3"><span class="sr-only"><%= t("shared.actions") %></span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% @pages.each do |page| %>
            <tr>
              <td class="px-6 py-4">
                <%= link_to page.title, edit_admin_page_path(page), class: "text-sm font-medium text-gray-900 hover:text-gray-600" %>
              </td>
              <td class="whitespace-nowrap px-6 py-4">
                <%= status_badge(page.status.capitalize, color_class: page.published? ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800') %>
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                <% if page.show_in_navigation? %>
                  <span class="inline-flex items-center rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-medium text-blue-800"><%= t("admin.pages.index.in_nav") %></span>
                <% end %>
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500 font-mono">/<%= page.slug %></td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                <%= link_to t("shared.edit"), edit_admin_page_path(page), class: "text-gray-600 hover:text-gray-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "admin/shared/empty_state", title: t("admin.pages.index.no_pages"), description: t("admin.pages.index.get_started"),
          action_label: t("admin.pages.index.new_page"), action_path: new_admin_page_path %>
  <% end %>
</div>
