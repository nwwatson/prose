<% content_for(:title, "Posts — #{site_name}") %>

<div class="space-y-6">
  <%= render "admin/shared/page_header", title: t('admin.posts.index.title'),
        action: link_to(t('admin.posts.index.new_post'), new_admin_post_path, class: admin_button_classes(variant: :primary, extra: "self-start")) %>

  <%# Search %>
  <div>
    <%= form_tag admin_posts_path, method: :get, class: "flex flex-wrap items-center gap-2" do %>
      <% if params[:status].present? %>
        <input type="hidden" name="status" value="<%= params[:status] %>">
      <% end %>
      <input type="search" name="search" value="<%= params[:search] %>" placeholder="<%= t('admin.posts.index.search_placeholder') %>" class="block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-gray-900 sm:max-w-xs sm:text-sm sm:leading-6">
      <button type="submit" class="rounded-md bg-gray-100 px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm hover:bg-gray-200"><%= t('shared.search') %></button>
    <% end %>
  </div>

  <%# Status tabs %>
  <div class="border-b border-gray-200">
    <nav class="-mb-px flex space-x-4 overflow-x-auto sm:space-x-8">
      <%= link_to t('shared.all'), admin_posts_path, class: "whitespace-nowrap border-b-2 #{params[:status].blank? ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'} px-1 pb-4 text-sm font-medium" %>
      <%= link_to t('shared.published'), admin_posts_path(status: "published"), class: "whitespace-nowrap border-b-2 #{params[:status] == 'published' ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'} px-1 pb-4 text-sm font-medium" %>
      <%= link_to t('shared.scheduled'), admin_posts_path(status: "scheduled"), class: "whitespace-nowrap border-b-2 #{params[:status] == 'scheduled' ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'} px-1 pb-4 text-sm font-medium" %>
      <%= link_to t('shared.drafts'), admin_posts_path(status: "draft"), class: "whitespace-nowrap border-b-2 #{params[:status] == 'draft' ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'} px-1 pb-4 text-sm font-medium" %>
    </nav>
  </div>

  <%# Post list %>
  <% if @posts.any? %>
    <%# Mobile card layout %>
    <div class="space-y-3 lg:hidden" data-testid="mobile-post-cards">
      <% @posts.each do |post| %>
        <%= link_to edit_admin_post_path(post), class: "block rounded-lg bg-white p-4 shadow ring-1 ring-gray-200" do %>
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
              <p class="text-sm font-medium text-gray-900"><%= post.title %></p>
              <% if post.subtitle.present? %>
                <p class="mt-0.5 truncate text-sm text-gray-500"><%= post.subtitle %></p>
              <% end %>
            </div>
            <%= status_badge(post.status.capitalize, color_class: "flex-shrink-0 #{post_status_color(post.status)}") %>
          </div>
          <div class="mt-2 flex items-center gap-3 text-xs text-gray-500">
            <span><%= post.user.display_name %></span>
            <span>&middot;</span>
            <span><%= post.published_at ? l(post.published_at.to_date, format: :short) : l(post.updated_at.to_date, format: :short) %></span>
          </div>
        <% end %>
      <% end %>
    </div>

    <%# Desktop table layout %>
    <div class="hidden overflow-hidden bg-white shadow ring-1 ring-gray-200 sm:rounded-lg lg:block" data-testid="desktop-post-table">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="<%= admin_th_classes %>"><%= t('admin.posts.index.title_header') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.posts.index.status') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.posts.index.author') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.posts.index.date') %></th>
            <th class="relative px-6 py-3"><span class="sr-only"><%= t('shared.actions') %></span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% @posts.each do |post| %>
            <tr>
              <td class="px-6 py-4">
                <div>
                  <%= link_to post.title, edit_admin_post_path(post), class: "text-sm font-medium text-gray-900 hover:text-gray-600" %>
                  <% if post.subtitle.present? %>
                    <p class="text-sm text-gray-500"><%= post.subtitle %></p>
                  <% end %>
                </div>
              </td>
              <td class="whitespace-nowrap px-6 py-4">
                <%= status_badge(post.status.capitalize, color_class: post_status_color(post.status)) %>
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500"><%= post.user.display_name %></td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                <%= post.published_at ? l(post.published_at.to_date, format: :short) : l(post.updated_at.to_date, format: :short) %>
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                <%= link_to t('shared.edit'), edit_admin_post_path(post), class: "text-gray-600 hover:text-gray-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "admin/shared/empty_state", title: t('admin.posts.index.no_posts'), description: t('admin.posts.index.get_started'),
          action_label: t('admin.posts.index.new_post'), action_path: new_admin_post_path %>
  <% end %>
</div>
