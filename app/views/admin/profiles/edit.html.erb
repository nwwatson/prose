<% content_for(:title, "#{t('admin.profiles.edit.title')} — #{site_name}") %>

<div class="max-w-4xl">
  <h1 class="text-2xl font-bold text-gray-900"><%= t('admin.profiles.edit.title') %></h1>
  <p class="mt-1 text-sm text-gray-600"><%= t('admin.profiles.edit.subtitle') %></p>

  <%= form_with model: @identity, url: admin_profile_path, class: "mt-8 space-y-6" do |f| %>
    <%= render "admin/shared/form_errors", record: @identity, heading: t('admin.profiles.edit.errors_prevented', count: @identity.errors.count), wrapper_class: "" %>

    <%# Avatar %>
    <%= render "admin/shared/field", form: f, attribute: :avatar, wrapper_class: "mt-2 flex items-center gap-4" do %>
      <% if @identity.avatar.attached? %>
        <%= image_tag @identity.avatar.variant(resize_to_fill: [96, 96]),
              class: "h-16 w-16 rounded-full object-cover" %>
      <% else %>
        <div class="flex h-16 w-16 items-center justify-center rounded-full bg-gray-200">
          <span class="text-xl font-bold text-gray-500"><%= @identity.name.first.upcase %></span>
        </div>
      <% end %>
      <div>
        <%= f.file_field :avatar, accept: "image/*",
              class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200" %>
        <p class="<%= admin_hint_classes %>"><%= t('admin.profiles.edit.avatar_help') %></p>
      </div>
    <% end %>

    <%# Name %>
    <%= render "admin/shared/field", form: f, attribute: :name, label: t('admin.profiles.edit.display_name') do %>
      <%= f.text_field :name, required: true,
            class: admin_input_classes %>
    <% end %>

    <%# Handle %>
    <%= render "admin/shared/field", form: f, attribute: :handle, wrapper_class: "mt-2 flex rounded-md shadow-sm",
          hint: t('admin.profiles.edit.handle_help') do %>
      <span class="inline-flex items-center rounded-l-md border border-r-0 border-gray-300 px-3 text-gray-500 sm:text-sm">/authors/</span>
      <%= f.text_field :handle,
            class: admin_input_classes(shape: :suffix),
            placeholder: t('admin.profiles.edit.handle_placeholder') %>
    <% end %>

    <%# Bio %>
    <%= render "admin/shared/field", form: f, attribute: :bio,
          hint: t('admin.profiles.edit.bio_help') do %>
      <%= f.text_area :bio, rows: 5,
            class: admin_input_classes,
            placeholder: t('admin.profiles.edit.bio_placeholder') %>
    <% end %>

    <%# Social links %>
    <%= render "admin/shared/settings_section", title: t('admin.profiles.edit.social_links'), description: t('admin.profiles.edit.social_links_description') do %>
      <div class="mt-4 space-y-4">
        <%= render "admin/shared/field", form: f, attribute: :website_url, label: t('admin.profiles.edit.website') do %>
          <%= f.url_field :website_url,
                class: admin_input_classes,
                placeholder: "https://example.com" %>
        <% end %>

        <%= render "admin/shared/field", form: f, attribute: :twitter_handle, label: t('admin.profiles.edit.twitter_handle'), wrapper_class: "mt-2 flex rounded-md shadow-sm" do %>
          <span class="inline-flex items-center rounded-l-md border border-r-0 border-gray-300 px-3 text-gray-500 sm:text-sm">@</span>
          <%= f.text_field :twitter_handle,
                class: admin_input_classes(shape: :suffix),
                placeholder: t('admin.profiles.edit.twitter_placeholder') %>
        <% end %>

        <%= render "admin/shared/field", form: f, attribute: :github_handle, label: t('admin.profiles.edit.github_handle'), wrapper_class: "mt-2 flex rounded-md shadow-sm" do %>
          <span class="inline-flex items-center rounded-l-md border border-r-0 border-gray-300 px-3 text-gray-500 sm:text-sm">github.com/</span>
          <%= f.text_field :github_handle,
                class: admin_input_classes(shape: :suffix),
                placeholder: t('admin.profiles.edit.github_placeholder') %>
        <% end %>
      </div>
    <% end %>

    <div class="flex items-center gap-4 border-t border-gray-200 pt-6">
      <%= f.submit t('admin.profiles.edit.save_profile'), class: admin_button_classes(size: :lg, extra: "focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-600 cursor-pointer") %>

      <% if @identity.handle.present? %>
        <%= link_to t('admin.profiles.edit.view_public_profile'), author_path(handle: @identity.handle),
              class: "text-sm text-gray-600 hover:text-gray-900", target: "_blank" %>
      <% end %>
    </div>
  <% end %>
</div>
