<% content_for(:title, "#{t('admin.segments.edit.title')} — #{site_name}") %>

<div class="space-y-6">
  <%= render "admin/shared/page_header", title: t('admin.segments.edit.title'), stack: false,
        action: button_to(t('shared.delete'), admin_segment_path(@segment), method: :delete, data: { turbo_confirm: t('shared.are_you_sure') }, class: admin_button_classes(variant: :danger)) %>
  <%= render "form", segment: @segment, labels: @labels %>
</div>
