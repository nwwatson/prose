<% content_for(:title, "#{@segment.name} — #{site_name}") %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= @segment.name %></h1>
      <% if @segment.description.present? %>
        <p class="mt-1 text-sm text-gray-500"><%= @segment.description %></p>
      <% end %>
    </div>
    <%= link_to t('shared.edit'), edit_admin_segment_path(@segment), class: admin_button_classes(variant: :primary) %>
  </div>

  <div class="rounded-md bg-gray-50 p-4">
    <p class="text-sm font-medium text-gray-900"><%= t('admin.segments.show.matching_subscribers') %></p>
    <p class="mt-1 text-2xl font-bold text-gray-900"><%= @segment.subscriber_count %></p>
  </div>

  <% if @subscribers.load.any? %>
    <div class="overflow-hidden bg-white shadow ring-1 ring-gray-200 sm:rounded-lg">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="<%= admin_th_classes %>"><%= t('admin.subscribers.index.email') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.segments.show.labels') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.subscribers.index.subscribed') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <%= render partial: "subscriber_row", collection: @subscribers, as: :subscriber %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "admin/shared/empty_state", description: t('admin.segments.show.no_subscribers') %>
  <% end %>

  <%= render "admin/shared/pagination", page: @page, next_page: @next_page %>
</div>
