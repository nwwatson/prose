<% content_for(:title, "#{t('shared.sign_in')} — #{site_name}") %>

<%= form_with url: admin_session_path, class: "space-y-6" do |f| %>
  <%= render "admin/shared/field", form: f, attribute: :email do %>
    <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email",
          class: admin_input_classes %>
  <% end %>

  <%= render "admin/shared/field", form: f, attribute: :password do %>
    <%= f.password_field :password, required: true, autocomplete: "current-password",
          class: admin_input_classes %>
  <% end %>

  <div>
    <%= f.submit t('shared.sign_in'), class: admin_button_classes(size: :sm, extra: "flex w-full justify-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-600 cursor-pointer") %>
  </div>
<% end %>

<% if Passkey.any? %>
  <div data-controller="passkey" class="mt-6">
    <div class="relative">
      <div class="absolute inset-0 flex items-center">
        <div class="w-full border-t border-gray-300"></div>
      </div>
      <div class="relative flex justify-center text-sm">
        <span class="bg-gray-50 px-2 text-gray-500"><%= t('shared.or') %></span>
      </div>
    </div>

    <div class="mt-6">
      <p data-passkey-target="error" class="hidden mb-3 rounded-md bg-red-50 p-3 text-sm text-red-800"></p>
      <button type="button" data-action="passkey#authenticate"
              class="<%= admin_button_classes(variant: :outline, size: :sm, extra: "flex w-full justify-center cursor-pointer") %>">
        <%= t('admin.sessions.new.sign_in_with_passkey') %>
      </button>
    </div>
  </div>
<% end %>
