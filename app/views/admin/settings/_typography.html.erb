<%# locals: (form:) %>
<%= render "admin/shared/settings_section", title: t('admin.settings.edit.typography'), description: t('admin.settings.edit.typography_description'),
      data: { controller: "typography-preview" } do %>
  <div class="mt-6 grid grid-cols-1 gap-8 lg:grid-cols-2">
    <%# Left column — Controls %>
    <div class="space-y-6">
      <% [
        [ "heading", t('admin.settings.edit.heading') ],
        [ "subtitle", t('admin.settings.edit.subtitle_group') ],
        [ "body", t('admin.settings.edit.body') ]
      ].each_with_index do |(group, heading), index| %>
        <% if index > 0 %>
          <hr class="border-gray-200">
        <% end %>

        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wide text-gray-500"><%= heading %></h3>
          <div class="mt-3 space-y-4">
            <%= render "admin/shared/field", form: form, attribute: :"#{group}_font", label: t('admin.settings.edit.font_family'), wrapper_class: nil do %>
              <%= render "shared/custom_select", form: form, field: :"#{group}_font",
                    options: SiteSetting::Typography::GOOGLE_FONTS,
                    data: { typography_preview_target: "#{group}Font", action: "typography-preview#update" } %>
            <% end %>
            <%= render "shared/range_slider", form: form, field: :"#{group}_font_size", label: t('admin.settings.edit.font_size'),
                  min: 0.75, max: 6, step: 0.125, suffix: "rem",
                  data: { typography_preview_target: "#{group}Size", action: "input->typography-preview#update" } %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Right column — Sticky preview %>
    <div class="lg:sticky lg:top-20 lg:self-start">
      <div class="rounded-md border border-gray-200 bg-white p-6">
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('shared.preview') %></p>
        <h2 data-typography-preview-target="previewHeading" class="text-3xl font-bold"><%= t('admin.settings.edit.preview_heading') %></h2>
        <p data-typography-preview-target="previewSubtitle" class="mt-1 text-lg text-gray-600"><%= t('admin.settings.edit.preview_subtitle') %></p>
        <p data-typography-preview-target="previewBody" class="mt-3 text-gray-700"><%= t('admin.settings.edit.preview_body') %></p>
      </div>
    </div>
  </div>
<% end %>
