<% content_for(:title, page_title(t('layouts.admin.settings'))) %>

<div class="max-w-4xl">
  <%= render "admin/shared/page_header", title: t('admin.settings.edit.title') %>
  <p class="mt-1 text-sm text-gray-600"><%= t('admin.settings.edit.subtitle') %></p>
  <% if current_user.admin? %>
    <p class="mt-2 text-sm text-gray-600">
      <%= link_to t('admin.settings.edit.export_content'), admin_exports_path, class: "font-medium text-gray-900 underline hover:text-gray-600" %>
    </p>
    <p class="mt-1 text-sm text-gray-600">
      <%= link_to t('admin.settings.edit.manage_navigation'), admin_navigation_items_path, class: "font-medium text-gray-900 underline hover:text-gray-600" %>
    </p>
  <% end %>

  <%= form_with model: @site_setting, url: admin_settings_path, class: "mt-8 space-y-6" do |f| %>
    <%= render "admin/shared/form_errors", record: @site_setting, heading: t('admin.settings.edit.errors_prevented', count: @site_setting.errors.count), wrapper_class: "" %>

    <%= render "admin/shared/field", form: f, attribute: :site_name do %>
      <%= f.text_field :site_name, required: true, class: admin_input_classes %>
    <% end %>

    <%= render "admin/shared/field", form: f, attribute: :site_description do %>
      <%= f.text_area :site_description, rows: 3, class: admin_input_classes, placeholder: t('admin.settings.edit.description_placeholder') %>
    <% end %>

    <%# Language %>
    <%= render "admin/shared/settings_section", title: t('admin.settings.edit.language'), description: t('admin.settings.edit.locale_description') do %>
      <div class="mt-4">
        <%= render "admin/shared/field", form: f, attribute: :locale, label: t('admin.settings.edit.locale'), wrapper_class: nil do %>
          <%= render "shared/custom_select", form: f, field: :locale,
                options: SiteSetting::Localization::SUPPORTED_LOCALES.map { |k, v| [v, k] } %>
        <% end %>
      </div>
    <% end %>

    <%= render "admin/shared/field", form: f, attribute: :default_og_image, label: t('admin.settings.edit.default_og_image'),
          hint: t('admin.settings.edit.og_image_help') do %>
      <% if @site_setting.default_og_image.attached? %>
        <div class="mb-3">
          <%= image_tag @site_setting.default_og_image, class: "max-h-48 rounded-md" %>
        </div>
      <% end %>
      <%= f.file_field :default_og_image, accept: "image/*", class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200" %>
    <% end %>

    <%# Appearance %>
    <% colors_json = SiteSetting::Appearance::BACKGROUND_COLORS.transform_values { |v| v[:hex] }.to_json %>
    <%= render "admin/shared/settings_section", title: t('admin.settings.edit.appearance'), description: t('admin.settings.edit.appearance_description'),
          data: {
            controller: "background-preview",
            background_preview_colors_value: colors_json
          } do %>
      <div class="mt-6 grid grid-cols-1 gap-8 lg:grid-cols-2">
        <div class="space-y-4">
          <%= render "admin/shared/field", form: f, attribute: :background_color, label: t('admin.settings.edit.background_color'), wrapper_class: nil do %>
            <%= render "shared/custom_select", form: f, field: :background_color,
                  options: SiteSetting::Appearance::BACKGROUND_COLORS.map { |key, meta| [meta[:name], key, { data: { color: meta[:hex] } }] },
                  data: { action: "change->background-preview#update" } %>
          <% end %>
        </div>

        <div class="lg:sticky lg:top-20 lg:self-start">
          <div class="rounded-md border border-gray-200 p-6" data-background-preview-target="preview" style="background-color: <%= @site_setting.background_hex %>;">
            <p class="mb-2 text-xs font-medium uppercase tracking-wide text-gray-400"><%= t('shared.preview') %></p>
            <h2 class="text-xl font-bold text-gray-900"><%= t('admin.settings.edit.your_site_background') %></h2>
            <p class="mt-2 text-sm text-gray-700"><%= t('admin.settings.edit.background_preview_help') %></p>
          </div>
        </div>
      </div>
    <% end %>

    <%# Theme Mode %>
    <%= render "admin/shared/settings_section", title: t('admin.settings.edit.theme_mode'), description: t('admin.settings.edit.theme_mode_description') do %>
      <div class="mt-4 space-y-3">
        <% [
          ["visitor_choice", t('admin.settings.edit.theme_mode_visitor_choice'), t('admin.settings.edit.theme_mode_visitor_choice_description')],
          ["light", t('admin.settings.edit.theme_mode_light'), t('admin.settings.edit.theme_mode_light_description')],
          ["dark", t('admin.settings.edit.theme_mode_dark'), t('admin.settings.edit.theme_mode_dark_description')]
        ].each do |value, label, description| %>
          <label class="flex items-start gap-3 cursor-pointer">
            <%= f.radio_button :theme_mode, value, class: "mt-1 h-4 w-4 text-gray-900 border-gray-300 focus:ring-gray-600" %>
            <div>
              <span class="text-sm font-medium text-gray-900"><%= label %></span>
              <p class="text-sm text-gray-500"><%= description %></p>
            </div>
          </label>
        <% end %>
      </div>
    <% end %>

    <%# Dark Theme %>
    <% dark_themes_json = SiteSetting::DarkTheme::DARK_THEMES.reject { |k, _| k == "custom" }.transform_values { |v| { bg: v[:bg], text: v[:text], accent: v[:accent] } }.to_json %>
    <%= render "admin/shared/settings_section", title: t('admin.settings.edit.dark_theme'), description: t('admin.settings.edit.dark_theme_description'),
          data: {
            controller: "dark-theme-preview",
            dark_theme_preview_themes_value: dark_themes_json,
            action: "color-pair:change->dark-theme-preview#updateCustom"
          } do %>
      <div class="mt-6 grid grid-cols-1 gap-8 lg:grid-cols-2">
        <div class="space-y-4">
          <%= render "admin/shared/field", form: f, attribute: :dark_theme, label: t('admin.settings.edit.dark_theme_label'), wrapper_class: nil do %>
            <%= render "shared/custom_select", form: f, field: :dark_theme,
                  options: SiteSetting::DarkTheme::DARK_THEMES.map { |key, meta| [meta[:name], key] },
                  data: { action: "change->dark-theme-preview#update" } %>
          <% end %>

          <div data-dark-theme-preview-target="customFields" class="<%= @site_setting.dark_theme == 'custom' ? '' : 'hidden' %> space-y-4">
            <%= render "admin/shared/color_field", form: f, attribute: :dark_bg_color, label: t('admin.settings.edit.background_color'),
                  target: { dark_theme_preview_target: "bgColor" } %>

            <%= render "admin/shared/color_field", form: f, attribute: :dark_text_color, label: t('admin.settings.edit.text_color'),
                  target: { dark_theme_preview_target: "textColor" } %>

            <%= render "admin/shared/color_field", form: f, attribute: :dark_accent_color, label: t('admin.settings.edit.accent_color'),
                  target: { dark_theme_preview_target: "accentColor" } %>
          </div>
        </div>

        <div class="lg:sticky lg:top-20 lg:self-start">
          <div class="rounded-md border border-gray-200 p-6" data-dark-theme-preview-target="preview"
               style="background-color: <%= @site_setting.dark_bg_hex %>; color: <%= @site_setting.dark_text_hex %>;">
            <p class="mb-2 text-xs font-medium uppercase tracking-wide" style="opacity: 0.5;"><%= t('shared.preview') %></p>
            <h2 class="text-xl font-bold"><%= t('admin.settings.edit.your_dark_theme') %></h2>
            <p class="mt-2 text-sm" style="opacity: 0.7;"><%= t('admin.settings.edit.dark_theme_preview_help') %></p>
            <span class="mt-2 inline-block cursor-pointer text-sm underline" data-dark-theme-preview-target="previewLink"
               style="color: <%= @site_setting.dark_accent_hex %>;" ><%= t('admin.settings.edit.sample_link') %></span>
          </div>
        </div>
      </div>
    <% end %>

    <%= render "typography", form: f %>

    <%# Search Engines %>
    <%= render "admin/shared/settings_section", title: t('admin.settings.edit.search_engines'), description: t('admin.settings.edit.search_engines_description') do %>
      <div class="mt-4">
        <%= render "shared/toggle", form: f, field: :block_crawlers,
              label: t('admin.settings.edit.block_crawlers'),
              description: t('admin.settings.edit.block_crawlers_description').html_safe %>
      </div>
    <% end %>

    <%# Fediverse (ActivityPub) %>
    <%= render "admin/shared/settings_section", title: t('admin.settings.edit.fediverse'), description: t('admin.settings.edit.fediverse_description') do %>
      <div class="mt-4 space-y-4">
        <%= render "shared/toggle", form: f, field: :activitypub_enabled,
              label: t('admin.settings.edit.activitypub_enabled'),
              description: t('admin.settings.edit.activitypub_enabled_description') %>

        <%= render "admin/shared/field", form: f, attribute: :activitypub_username, label: t('admin.settings.edit.activitypub_username'),
              hint: t('admin.settings.edit.activitypub_username_hint') do %>
          <%= f.text_field :activitypub_username, autocomplete: "off", class: admin_input_classes %>
        <% end %>

        <% if @site_setting.activitypub_enabled? && @site_setting.persisted? && !@site_setting.activitypub_enabled_changed? %>
          <div class="rounded-md bg-gray-50 p-4 text-sm text-gray-700">
            <p><%= t('admin.settings.edit.activitypub_handle') %> <code class="font-mono text-gray-900"><%= @site_setting.activitypub_handle %></code></p>
            <p class="mt-1"><%= t('admin.settings.edit.activitypub_followers', count: FediverseActor.followers.count) %></p>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# Payment Configuration %>
    <%= render "admin/shared/settings_section", title: t('admin.settings.edit.payment_configuration'), description: t('admin.settings.edit.payment_description') do %>
      <div class="mt-4 space-y-4">
        <%= render "admin/shared/secret_field", form: f, attribute: :stripe_publishable_key, label: t('admin.settings.edit.stripe_publishable_key'), placeholder: "pk_live_..." %>

        <%= render "admin/shared/secret_field", form: f, attribute: :stripe_secret_key, label: t('admin.settings.edit.stripe_secret_key'), placeholder: "sk_live_..." %>

        <%= render "admin/shared/secret_field", form: f, attribute: :stripe_webhook_secret, label: t('admin.settings.edit.stripe_webhook_secret'), placeholder: "whsec_...",
              hint: [
                t('admin.settings.edit.webhook_help'),
                safe_join([ t('admin.settings.edit.webhook_url'), " ", tag.code(webhooks_stripe_url, class: "rounded bg-gray-100 px-1 py-0.5") ])
              ] %>

        <%= render "admin/shared/field", form: f, attribute: :payments_currency, label: t('admin.settings.edit.payments_currency'), wrapper_class: nil do %>
          <%= render "shared/custom_select", form: f, field: :payments_currency,
                options: SiteSetting::PaymentConfiguration::SUPPORTED_CURRENCIES.map { |k, v| [v, k] } %>
        <% end %>
      </div>
    <% end %>

    <%# AI Configuration %>
    <%= render "admin/shared/settings_section", title: t('admin.settings.edit.ai_configuration'), description: t('admin.settings.edit.ai_description') do %>
      <div class="mt-4 space-y-4">
        <%= render "admin/shared/secret_field", form: f, attribute: :claude_api_key, label: t('admin.settings.edit.anthropic_api_key'), placeholder: "sk-ant-...",
              hint: t('admin.settings.edit.anthropic_help') %>

        <%= render "admin/shared/secret_field", form: f, attribute: :gemini_api_key, label: t('admin.settings.edit.gemini_api_key'), placeholder: "AIza...",
              hint: t('admin.settings.edit.gemini_help') %>

        <%= render "admin/shared/secret_field", form: f, attribute: :openai_api_key, label: t('admin.settings.edit.openai_api_key'), placeholder: "sk-...",
              hint: t('admin.settings.edit.openai_help') %>

        <%= render "admin/shared/field", form: f, attribute: :ai_model, label: t('admin.settings.edit.ai_model'), wrapper_class: nil do %>
          <%= render "shared/custom_select", form: f, field: :ai_model,
                options: SiteSetting::AiConfiguration::AI_MODELS.map { |m| [m, m] } %>
        <% end %>

        <%= render "admin/shared/field", form: f, attribute: :image_model, label: t('admin.settings.edit.image_model'), wrapper_class: nil,
              hint: t('admin.settings.edit.image_model_help') do %>
          <%= render "shared/custom_select", form: f, field: :image_model,
                options: SiteSetting::AiConfiguration::IMAGE_MODELS.keys.map { |m| [m, m] } %>
        <% end %>

        <%= render "admin/shared/field", form: f, attribute: :ai_max_tokens, label: t('admin.settings.edit.max_tokens'),
              hint: t('admin.settings.edit.max_tokens_help') do %>
          <%= f.number_field :ai_max_tokens, min: 256, max: 16384, step: 256,
                class: admin_input_classes %>
        <% end %>
      </div>
    <% end %>

    <div class="flex justify-end border-t border-gray-200 pt-6">
      <%= f.submit t('admin.settings.edit.save_settings'), class: "#{admin_button_classes(variant: :primary)} cursor-pointer" %>
    </div>
  <% end %>
</div>
