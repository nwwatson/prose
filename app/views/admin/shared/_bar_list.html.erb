<%# locals: (counts:, empty:, limit: nil) %>
<%# counts: a Hash of label => count, drawn as bars relative to the largest count. limit: shows only the first N. %>
<% if counts.any? %>
  <div class="space-y-3">
    <% max_count = counts.values.max %>
    <% (limit ? counts.first(limit) : counts).each do |label, count| %>
      <div>
        <div class="flex justify-between text-sm mb-1">
          <span class="font-medium text-gray-700 capitalize"><%= label %></span>
          <span class="text-gray-500"><%= count %></span>
        </div>
        <div class="w-full bg-gray-100 rounded-full h-2">
          <div class="bg-blue-600 h-2 rounded-full" style="width: <%= max_count > 0 ? (count.to_f / max_count * 100).round(1) : 0 %>%"></div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-sm text-gray-500"><%= empty %></p>
<% end %>
