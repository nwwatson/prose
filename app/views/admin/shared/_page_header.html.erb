<%# locals: (title:, action: nil, stack: true) %>
<%# stack: false keeps the action beside the title on narrow screens too. %>
<div class="<%= stack ? "flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between" : "flex items-center justify-between" %>">
  <h1 class="text-2xl font-bold text-gray-900"><%= title %></h1>
  <%= action %>
</div>
