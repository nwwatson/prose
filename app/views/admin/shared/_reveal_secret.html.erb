<%# locals: (secret:, message:, copy_label:, wrapper_class: nil) %>
<%# A secret shown once. The copy button reads it from the DOM, so it is never interpolated into JavaScript. %>
<%= tag.div class: [ wrapper_class, "rounded-lg border border-green-200 bg-green-50 p-4" ], data: { controller: "clipboard" } do %>
  <p class="text-sm font-medium text-green-800 mb-2"><%= message %></p>
  <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
    <code class="flex-1 rounded bg-white px-3 py-2 font-mono text-sm text-gray-900 border border-green-200 select-all break-all" data-clipboard-target="source"><%= secret %></code>
    <button type="button" data-action="clipboard#copy" class="self-start rounded bg-green-600 px-3 py-2 text-sm font-medium text-white hover:bg-green-700">
      <%= copy_label %>
    </button>
  </div>
<% end %>
