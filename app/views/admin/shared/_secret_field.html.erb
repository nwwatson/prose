<%# locals: (form:, attribute:, label:, placeholder:, hint: nil) %>
<%# An encrypted SiteSetting key: shows the mask, never the stored value (see SiteSetting::MaskedSecrets). %>
<%= render "admin/shared/field", form: form, attribute: attribute, label: label, hint: hint do %>
  <%= form.password_field attribute,
        value: form.object.masked_value_for(attribute),
        placeholder: placeholder,
        autocomplete: "off",
        class: admin_input_classes %>
<% end %>
