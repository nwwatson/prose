<%# locals: (label:, value:, trend: nil, note: nil) %>
<div class="bg-white overflow-hidden shadow rounded-lg">
  <div class="p-4 sm:p-5">
    <div class="text-sm font-medium text-gray-500 truncate"><%= label %></div>
    <div class="mt-1 text-2xl font-semibold text-gray-900 sm:text-3xl"><%= value %></div>
    <% if trend %><%= render_trend(trend) %><% end %>
    <% if note %><div class="mt-1 text-xs text-gray-500"><%= note %></div><% end %>
  </div>
</div>
