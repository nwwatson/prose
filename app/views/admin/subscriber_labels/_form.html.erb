<%= form_with model: [ :admin, label ], class: "space-y-6" do |f| %>
  <%= render "admin/shared/form_errors", record: label, wrapper_class: "" %>

  <div class="max-w-lg space-y-6">
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-900" %>
      <div class="mt-2">
        <%= f.text_field :name, class: admin_input_classes %>
      </div>
    </div>

    <div>
      <%= f.label :color, class: "block text-sm font-medium text-gray-900" %>
      <div class="mt-2 flex items-center gap-2">
        <%= f.color_field :color, class: "h-8 w-8 cursor-pointer rounded border border-gray-300 p-0.5" %>
        <%= f.text_field :color, class: admin_input_classes, placeholder: "#6B7280" %>
      </div>
    </div>

    <div class="flex justify-end space-x-3">
      <%= link_to t('shared.cancel'), admin_subscriber_labels_path, class: admin_button_classes(variant: :outline) %>
      <%= f.submit class: "#{admin_button_classes(variant: :primary)} cursor-pointer" %>
    </div>
  </div>
<% end %>
