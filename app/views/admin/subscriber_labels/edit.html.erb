<% content_for(:title, "#{t('admin.subscriber_labels.edit.title')} — #{site_name}") %>

<div class="space-y-6">
  <%= render "admin/shared/page_header", title: t('admin.subscriber_labels.edit.title'), stack: false,
        action: button_to(t('shared.delete'), admin_subscriber_label_path(@label), method: :delete, data: { turbo_confirm: t('shared.are_you_sure') }, class: admin_button_classes(variant: :danger)) %>
  <%= render "form", label: @label %>
</div>
