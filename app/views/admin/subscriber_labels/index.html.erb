<% content_for(:title, "#{t('admin.subscriber_labels.index.title')} — #{site_name}") %>

<div class="space-y-6">
  <%= render "admin/shared/page_header", title: t('admin.subscriber_labels.index.title'),
        action: link_to(t('admin.subscriber_labels.index.new_label'), new_admin_subscriber_label_path, class: admin_button_classes(variant: :primary, extra: "self-start")) %>

  <% if @labels.load.any? %>
    <%# Mobile card layout %>
    <div class="space-y-3 lg:hidden">
      <%= render partial: "card", collection: @labels, as: :label, locals: { subscriber_counts: @subscriber_counts } %>
    </div>

    <%# Desktop table layout %>
    <div class="hidden overflow-hidden bg-white shadow ring-1 ring-gray-200 sm:rounded-lg lg:block">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="<%= admin_th_classes %>"><%= t('admin.subscriber_labels.index.name') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.subscriber_labels.index.color') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.subscriber_labels.index.subscribers') %></th>
            <th class="relative px-6 py-3"><span class="sr-only"><%= t('shared.actions') %></span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <%= render partial: "row", collection: @labels, as: :label, locals: { subscriber_counts: @subscriber_counts } %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "admin/shared/empty_state", title: t('admin.subscriber_labels.index.no_labels'), description: t('admin.subscriber_labels.index.get_started'),
          action_label: t('admin.subscriber_labels.index.new_label'), action_path: new_admin_subscriber_label_path %>
  <% end %>
</div>
