<% content_for(:title, "Subscribers — #{site_name}") %>

<div class="space-y-6">
  <%= render "admin/shared/page_header", title: t('admin.subscribers.index.title'),
        action: content_tag(:p, t('admin.subscribers.index.confirmed_of_total', confirmed: @confirmed_subscribers_count, total: @total_subscribers_count), class: "text-sm text-gray-500") %>

  <% if @labels.load.any? %>
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-sm text-gray-500"><%= t('admin.subscribers.index.filter_by_label') %></span>
      <div class="flex flex-wrap gap-2 overflow-x-auto">
        <%= link_to t('shared.all'), admin_subscribers_path, class: "rounded-full px-3 py-1.5 text-xs font-medium #{params[:label].blank? ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
        <% @labels.each do |label| %>
          <%= link_to label.name, admin_subscribers_path(label: label.id), class: "inline-flex items-center gap-1 rounded-full px-3 py-1.5 text-xs font-medium #{params[:label].to_s == label.id.to_s ? 'text-white' : 'text-gray-700 bg-gray-100 hover:bg-gray-200'}", style: params[:label].to_s == label.id.to_s ? "background-color: #{label.color}" : "" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @subscribers.load.any? %>
    <%# Mobile card layout %>
    <div class="space-y-3 lg:hidden">
      <%= render partial: "card", collection: @subscribers, as: :subscriber %>
    </div>

    <%# Desktop table layout %>
    <div class="hidden overflow-hidden bg-white shadow ring-1 ring-gray-200 sm:rounded-lg lg:block">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="<%= admin_th_classes %>"><%= t('admin.subscribers.index.email') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.subscribers.index.labels') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.subscribers.index.status') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.subscribers.index.subscribed') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <%= render partial: "row", collection: @subscribers, as: :subscriber %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "admin/shared/empty_state", description: t('admin.subscribers.index.no_subscribers') %>
  <% end %>

  <%= render "admin/shared/pagination", page: @page, next_page: @next_page %>
</div>
