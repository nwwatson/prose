<% content_for(:title, "#{t('admin.traffic.show.title')} — #{site_name}") %>

<div>
  <h1 class="text-2xl font-bold text-gray-900"><%= t('admin.traffic.show.title') %></h1>
  <p class="mt-2 text-sm text-gray-600"><%= t('admin.traffic.show.subtitle') %></p>
</div>

<%# KPI Cards %>
<div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-3 sm:gap-5">
  <%= render "admin/shared/stat_card", label: t('admin.traffic.show.total_views'), value: @total_views %>
  <%= render "admin/shared/stat_card", label: t('admin.traffic.show.unique_viewers'), value: @unique_viewers %>
  <%= render "admin/shared/stat_card", label: t('admin.traffic.show.top_source'), value: @top_source, value_class: "capitalize" %>
</div>

<%# Range Selector + Views Chart %>
<% range_selector = render("admin/shared/range_selector",
                           ranges: Admin::TrafficController::ALLOWED_RANGES,
                           current: @range,
                           path: ->(range) { admin_traffic_path(range: range) }) %>
<%= render "admin/shared/panel", title: t('admin.traffic.show.views_over_time'), action: range_selector, stack: true,
           wrapper_class: "mt-8", data: { controller: "traffic-chart", traffic_chart_data_value: @views_by_day.to_json } do %>
  <div data-traffic-chart-target="canvas" class="w-full min-h-[200px]" style="height: 300px;"></div>

  <% if @views_by_day.empty? %>
    <p class="mt-4 text-sm text-gray-500 text-center"><%= t('admin.traffic.show.no_data') %></p>
  <% end %>
<% end %>

<%# Traffic Sources %>
<div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-2">
  <%= render "admin/shared/panel", title: t('admin.traffic.show.traffic_sources') do %>
    <%= render "admin/shared/bar_list", counts: @traffic_sources, empty: t('admin.traffic.show.no_traffic_data') %>
  <% end %>

  <%= render "admin/shared/panel", title: t('admin.traffic.show.top_referrer_domains') do %>
    <%= render "admin/shared/count_table", headers: [ t('admin.traffic.show.domain'), t('admin.traffic.show.views') ],
               rows: @top_domains, empty: t('admin.traffic.show.no_referrer_data') %>
  <% end %>
</div>

<%# UTM Breakdowns %>
<div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-3">
  <% { utm_campaigns: [ @utm_campaigns, :campaign ], utm_sources: [ @utm_sources, :source ], utm_mediums: [ @utm_mediums, :medium ] }.each do |title_key, (counts, column_key)| %>
    <%= render "admin/shared/panel", title: t("admin.traffic.show.#{title_key}") do %>
      <%= render "admin/shared/count_table", headers: [ t("admin.traffic.show.#{column_key}"), t('admin.traffic.show.views') ],
                 rows: counts, empty: t('admin.traffic.show.no_utm_data') %>
    <% end %>
  <% end %>
</div>
