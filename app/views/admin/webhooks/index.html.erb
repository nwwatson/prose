<% content_for(:title, "#{t('admin.webhooks.index.title')} — #{site_name}") %>

<div class="space-y-6">
  <%= render "admin/shared/page_header", title: t('admin.webhooks.index.title'),
        action: link_to(t('admin.webhooks.index.new_webhook'), new_admin_webhook_path, class: admin_button_classes(variant: :primary, extra: "self-start")) %>

  <% if @webhooks.any? %>
    <%# Mobile card layout %>
    <div class="space-y-3 lg:hidden">
      <% @webhooks.each do |webhook| %>
        <div class="rounded-lg border border-gray-200 bg-white p-4">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-gray-900"><%= webhook.url %></p>
              <p class="mt-1 text-xs text-gray-500"><%= webhook.events.join(", ") %></p>
            </div>
            <% if webhook.active? %>
              <%= status_badge(t('shared.active'), color_class: "flex-shrink-0 bg-green-100 text-green-800", size: :sm) %>
            <% else %>
              <%= status_badge(t('admin.webhooks.index.disabled'), color_class: "flex-shrink-0 bg-red-100 text-red-800", size: :sm) %>
            <% end %>
          </div>
          <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500">
            <span><%= t('admin.webhooks.index.last_triggered') %>: <%= webhook.last_triggered_at ? time_ago_in_words(webhook.last_triggered_at) + " " + t('shared.ago') : t('shared.never') %></span>
            <% if webhook.last_response_code %>
              <span><%= t('admin.webhooks.index.last_response') %>: <%= webhook.last_response_code %></span>
            <% end %>
          </div>
          <div class="mt-3 flex gap-3">
            <%= link_to t('shared.edit'), edit_admin_webhook_path(webhook), class: "text-xs font-medium text-gray-600 hover:text-gray-900" %>
            <%= link_to t('admin.webhooks.index.deliveries'), admin_webhook_webhook_deliveries_path(webhook), class: "text-xs font-medium text-gray-600 hover:text-gray-900" %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Desktop table layout %>
    <div class="hidden overflow-hidden rounded-lg border border-gray-200 bg-white lg:block">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="<%= admin_th_classes %>"><%= t('admin.webhooks.index.url') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.webhooks.index.events') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.webhooks.index.last_triggered') %></th>
            <th class="<%= admin_th_classes %>"><%= t('admin.webhooks.index.status') %></th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @webhooks.each do |webhook| %>
            <tr>
              <td class="px-4 py-3 text-sm font-medium text-gray-900">
                <%= link_to webhook.url, edit_admin_webhook_path(webhook), class: "hover:text-gray-600" %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-500"><%= truncate(webhook.events.join(", "), length: 50) %></td>
              <td class="px-4 py-3 text-sm text-gray-500">
                <%= webhook.last_triggered_at ? time_ago_in_words(webhook.last_triggered_at) + " " + t('shared.ago') : t('shared.never') %>
              </td>
              <td class="px-4 py-3 text-sm">
                <% if webhook.active? %>
                  <%= status_badge(t('shared.active'), color_class: "bg-green-100 text-green-800", size: :sm) %>
                <% else %>
                  <%= status_badge(t('admin.webhooks.index.disabled'), color_class: "bg-red-100 text-red-800", size: :sm) %>
                <% end %>
              </td>
              <td class="px-4 py-3 text-right text-sm">
                <%= link_to t('admin.webhooks.index.deliveries'), admin_webhook_webhook_deliveries_path(webhook), class: "text-gray-600 hover:text-gray-900 font-medium" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "admin/shared/empty_state", description: t('admin.webhooks.index.no_webhooks'),
          action_label: t('admin.webhooks.index.new_webhook'), action_path: new_admin_webhook_path %>
  <% end %>
</div>
