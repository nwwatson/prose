<% content_for(:title, page_title(@identity.name)) %>

<% content_for(:head) do %>
  <% description = @identity.bio.present? ? strip_tags(@identity.bio_html).truncate(160) : t('authors.show.posts_by', name: @identity.name, site_name: site_name) %>
  <%= seo_head_tags(
        title: "#{@identity.name} — #{site_name}",
        description: description,
        url: author_url(@identity, handle: @identity.handle)
      ) %>
  <%= json_ld_for_author(@identity) %>
<% end %>

<%# Author header %>
<div class="author-profile">
  <div class="author-profile__inner">
    <% if @identity.avatar.attached? %>
      <%= image_tag @identity.avatar.variant(resize_to_fill: [128, 128]),
            class: "author-profile__avatar",
            alt: @identity.name %>
    <% else %>
      <div class="author-profile__avatar-placeholder">
        <span class="author-profile__avatar-initial"><%= @identity.name.first.upcase %></span>
      </div>
    <% end %>

    <div class="author-profile__info">
      <h1 class="page-heading"><%= @identity.name %></h1>

      <% if @identity.bio.present? %>
        <div class="author-profile__bio prose prose-sm dark:prose-invert">
          <%= sanitize @identity.bio_html %>
        </div>
      <% end %>

      <div class="author-profile__meta">
        <span><%= t('authors.show.posts_published', count: @total_posts) %></span>

        <% if @identity.has_social_links? %>
          <span class="post-meta__separator">&middot;</span>
          <div class="author-profile__social-links">
            <% if @identity.website_url.present? %>
              <%= link_to @identity.website_url.sub(%r{\Ahttps?://}, ""), @identity.website_url,
                    class: "author-profile__social-link", target: "_blank", rel: "noopener" %>
            <% end %>
            <% if @identity.twitter_url.present? %>
              <%= link_to "@#{@identity.twitter_handle}", @identity.twitter_url,
                    class: "author-profile__social-link", target: "_blank", rel: "noopener" %>
            <% end %>
            <% if @identity.github_url.present? %>
              <%= link_to @identity.github_handle, @identity.github_url,
                    class: "author-profile__social-link", target: "_blank", rel: "noopener" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%# Post archive %>
<% if @posts.any? %>
  <h2 class="section-heading"><%= t('authors.show.posts_by_author', name: @identity.name) %></h2>

  <div class="post-listing">
    <% @posts.each do |post| %>
      <%= render "posts/post", post: post, show_author: false %>
    <% end %>
  </div>

  <% if @next_page %>
    <div class="load-more">
      <%= link_to t('authors.show.load_more'), author_path(@identity, handle: @identity.handle, page: @next_page),
            class: "btn btn--primary" %>
    </div>
  <% end %>
<% else %>
  <div class="empty-state">
    <p class="empty-state__text"><%= t('authors.show.no_posts') %></p>
  </div>
<% end %>
