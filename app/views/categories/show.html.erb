<% content_for(:title, page_title(@category.name)) %>

<% content_for(:head) do %>
  <% cat_description = @category.description.presence || "Browse posts in #{@category.name}" %>
  <%= seo_head_tags(
        title: "#{@category.name} — #{site_name}",
        description: cat_description,
        url: category_url(@category, slug: @category.slug),
        json_ld: { "@context": "https://schema.org", "@type": "CollectionPage", name: @category.name, description: cat_description, url: category_url(@category, slug: @category.slug) }
      ) %>
<% end %>

<div>
  <h1 class="page-heading"><%= @category.name %></h1>
  <% if @category.description.present? %>
    <p class="page-subtitle"><%= @category.description %></p>
  <% end %>
</div>

<div class="post-listing">
  <% @posts.each do |post| %>
    <%= render "posts/post", post: post, show_subtitle: false, show_reading_time: false, show_category: false %>
  <% end %>
</div>
