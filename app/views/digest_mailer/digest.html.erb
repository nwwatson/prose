<h1 style="margin: 0 0 8px; font-size: 22px; font-weight: 700; color: <%= @email_heading_color %>;">
  <%= t('digest_mailer.digest.heading', site_name: @site_name) %>
</h1>

<p style="margin: 0 0 24px; font-size: 15px; line-height: 22px; color: <%= @email_body_text_color %>;">
  <%= t('digest_mailer.digest.intro', count: @total_count) %>
</p>

<% @posts.each_with_index do |post, index| %>
  <% post_link = post_url(slug: post.slug) %>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="<%= 'border-top: 1px solid #e4e4e7;' if index.positive? %>">
    <tr>
      <td style="padding: <%= index.positive? ? '24px' : '0' %> 0 24px;">
        <% if (image_url = digest_featured_image_url(post)) %>
          <a href="<%= post_link %>" style="display: block; margin: 0 0 16px;">
            <img src="<%= image_url %>" alt="<%= post.title %>" width="536" style="display: block; width: 100%; max-width: 536px; height: auto; border-radius: 6px; border: 0;">
          </a>
        <% end %>

        <h2 style="margin: 0 0 6px; font-size: 18px; line-height: 26px; font-weight: 700;">
          <a href="<%= post_link %>" style="color: <%= @email_heading_color %>; text-decoration: none;"><%= post.title %></a>
        </h2>

        <p style="margin: 0 0 10px; font-size: 13px; color: #a1a1aa;">
          <%= t('shared.by') %> <%= post.user.display_name %> &middot; <%= l(post.published_at.to_date, format: :long) %>
        </p>

        <% if post.seo_description.present? %>
          <p style="margin: 0 0 12px; font-size: 15px; line-height: 22px; color: <%= @email_body_text_color %>;">
            <%= post.seo_description %>
          </p>
        <% end %>

        <a href="<%= post_link %>" style="font-size: 14px; font-weight: 600; color: <%= @email_accent_color %>; text-decoration: none;">
          <%= t('digest_mailer.digest.read_more') %> &rarr;
        </a>
      </td>
    </tr>
  </table>
<% end %>

<% if @total_count > @posts.size %>
  <%= render "mailer/cta_button",
             url: root_url,
             label: t('digest_mailer.digest.view_all', count: @total_count - @posts.size),
             color: @email_accent_color %>
<% end %>
