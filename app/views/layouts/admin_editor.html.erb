<!DOCTYPE html>
<html class="h-full bg-white">
  <head>
    <%= render "layouts/editor/head", default_title: "Editor — #{site_name}" %>
  </head>

  <body class="h-full">
    <% ai_available = site_setting.ai_configured? && @post&.persisted? %>
    <div data-controller="autosave editor-drawer post-preview"
         data-autosave-back-url-value="<%= admin_posts_path %>"
         <% if @post&.persisted? %>
           data-autosave-url-value="<%= admin_post_path(@post) %>"
           data-autosave-method-value="PATCH"
           data-autosave-persisted-value="true"
         <% else %>
           data-autosave-url-value="<%= admin_posts_path %>"
           data-autosave-method-value="POST"
           data-autosave-persisted-value="false"
         <% end %>
         data-editor-drawer-ai-available-value="<%= ai_available %>"
         data-editor-drawer-active-tab-value="<%= ai_available ? 'ai' : 'settings' %>"
         <% if ai_available %>
           data-editor-drawer-post-slug-value="<%= @post.to_param %>"
         <% end %>
         class="relative min-h-full">
      <%= render "layouts/editor/top_bar", back_label: t("layouts.admin_editor.posts") %>

      <%= render "layouts/shared/flash" %>

      <%# Centered writing area %>
      <div data-editor-drawer-target="mainContent" class="transition-[margin] duration-300">
        <main class="mx-auto w-full max-w-3xl px-4 py-8">
          <%= yield %>
        </main>
      </div>

      <%= render "layouts/editor/overlay" %>
      <%= render "layouts/editor/discard_modal",
                 title: t("layouts.admin_editor.discard_post"),
                 message: t("layouts.admin_editor.discard_post_message") %>

      <%# Unified editor panel %>
      <%= render "admin/posts/editor_panel",
                 post: @post || Post.new,
                 ai_available: ai_available,
                 chat: @chat,
                 messages: @chat ? @chat.messages.where(role: %w[user assistant]).order(:created_at) : [] %>

    </div>
  </body>
</html>
