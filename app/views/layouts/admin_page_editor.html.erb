<!DOCTYPE html>
<html class="h-full bg-white">
  <head>
    <%= render "layouts/editor/head", default_title: "Page Editor — #{site_name}" %>
  </head>

  <body class="h-full">
    <div data-controller="autosave editor-drawer"
         <% if @page&.persisted? %>
           data-autosave-url-value="<%= admin_page_path(@page) %>"
           data-autosave-method-value="PATCH"
           data-autosave-persisted-value="true"
           data-autosave-back-url-value="<%= admin_pages_path %>"
         <% else %>
           data-autosave-url-value="<%= admin_pages_path %>"
           data-autosave-method-value="POST"
           data-autosave-persisted-value="false"
           data-autosave-back-url-value="<%= admin_pages_path %>"
         <% end %>
         data-editor-drawer-active-tab-value="settings"
         class="relative min-h-full">
      <%= render "layouts/editor/top_bar", back_label: t("layouts.admin_page_editor.pages") %>

      <%= render "layouts/shared/flash" %>

      <%# Centered writing area %>
      <div data-editor-drawer-target="mainContent" class="transition-[margin] duration-300">
        <main class="mx-auto w-full max-w-3xl px-4 py-8">
          <%= yield %>
        </main>
      </div>

      <%= render "layouts/editor/overlay" %>
      <%= render "layouts/editor/discard_modal",
                 title: t("layouts.admin_page_editor.discard_page"),
                 message: t("layouts.admin_page_editor.discard_page_message") %>

      <%# Settings panel %>
      <div data-editor-drawer-target="panel"
           class="fixed top-14 right-0 bottom-0 z-50 flex w-full translate-x-full flex-col border-l border-gray-200 bg-white shadow-xl transition-transform duration-300 ease-in-out sm:w-[28rem]">
        <div class="flex items-center justify-between border-b border-gray-200 px-4 py-2">
          <span class="text-sm font-semibold text-gray-900"><%= t("admin.pages.editor_panel.title") %></span>
          <button type="button" data-action="click->editor-drawer#togglePin" title="Pin panel"
                  class="hidden rounded-md p-1.5 text-gray-400 hover:text-gray-600 focus:outline-none sm:inline-flex">
            <svg data-editor-drawer-target="pinIcon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
            </svg>
          </button>
        </div>

        <div data-editor-drawer-target="tabContent" data-tab="settings"
             class="flex-1 overflow-y-auto"
             data-action="change->autosave#handleChange input->autosave#scheduleAutosave">
          <%= render "admin/pages/settings_fields", page: @page || Page.new %>
        </div>
      </div>

    </div>
  </body>
</html>
