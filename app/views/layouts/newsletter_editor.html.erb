<!DOCTYPE html>
<html class="h-full bg-white">
  <head>
    <%= render "layouts/editor/head", default_title: "Newsletter Editor — #{site_name}", fonts: false %>
  </head>

  <body class="h-full">
    <div data-controller="autosave editor-drawer"
         data-autosave-back-url-value="<%= admin_newsletters_path %>"
         data-autosave-form-selector-value="#newsletter_form"
         data-autosave-title-selector-value="#newsletter_title"
         <% if @newsletter&.persisted? %>
           data-autosave-url-value="<%= admin_newsletter_path(@newsletter) %>"
           data-autosave-method-value="PATCH"
           data-autosave-persisted-value="true"
         <% else %>
           data-autosave-url-value="<%= admin_newsletters_path %>"
           data-autosave-method-value="POST"
           data-autosave-persisted-value="false"
         <% end %>
         data-editor-drawer-ai-available-value="false"
         data-editor-drawer-active-tab-value="settings"
         class="relative min-h-full">
      <%= render "layouts/editor/top_bar", back_label: t("layouts.newsletter_editor.newsletters") %>

      <%= render "layouts/shared/flash" %>

      <%# Centered writing area %>
      <div data-editor-drawer-target="mainContent" class="transition-[margin] duration-300">
        <main class="mx-auto w-full max-w-3xl px-4 py-8">
          <%= yield %>
        </main>
      </div>

      <%= render "layouts/editor/overlay" %>
      <%= render "layouts/editor/discard_modal",
                 title: t("layouts.newsletter_editor.discard_newsletter"),
                 message: t("layouts.newsletter_editor.discard_newsletter_message") %>

      <%# Editor panel %>
      <%= render "admin/newsletters/editor_panel", newsletter: @newsletter || Newsletter.new %>

    </div>
  </body>
</html>
