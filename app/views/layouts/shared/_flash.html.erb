<%# locals: (variant: :editor) %>
<% case variant
   when :public %>
  <% if notice %>
    <div class="flash flash--notice">
      <div class="flash__inner"><p class="flash__text"><%= notice %></p></div>
    </div>
  <% end %>
  <% if alert %>
    <div class="flash flash--alert">
      <div class="flash__inner"><p class="flash__text"><%= alert %></p></div>
    </div>
  <% end %>
<% when :auth %>
  <% if alert %>
    <div class="mt-4 sm:mx-auto sm:w-full sm:max-w-sm">
      <div class="rounded-md bg-red-50 p-4">
        <p class="text-sm text-red-800"><%= alert %></p>
      </div>
    </div>
  <% end %>
  <% if notice %>
    <div class="mt-4 sm:mx-auto sm:w-full sm:max-w-sm">
      <div class="rounded-md bg-green-50 p-4">
        <p class="text-sm text-green-800"><%= notice %></p>
      </div>
    </div>
  <% end %>
<% when :admin %>
  <% if notice %>
    <div class="bg-green-50 border-b border-green-200 px-4 py-3">
      <p class="text-sm text-green-800"><%= notice %></p>
    </div>
  <% end %>
  <% if alert %>
    <div class="bg-red-50 border-b border-red-200 px-4 py-3">
      <p class="text-sm text-red-800"><%= alert %></p>
    </div>
  <% end %>
<% else %>
  <% if notice %>
    <div class="border-b border-green-200 bg-green-50 px-4 py-3">
      <div class="mx-auto max-w-3xl">
        <p class="text-sm text-green-800"><%= notice %></p>
      </div>
    </div>
  <% end %>
  <% if alert %>
    <div class="border-b border-red-200 bg-red-50 px-4 py-3">
      <div class="mx-auto max-w-3xl">
        <p class="text-sm text-red-800"><%= alert %></p>
      </div>
    </div>
  <% end %>
<% end %>
