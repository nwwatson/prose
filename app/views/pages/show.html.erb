<% content_for(:title, page_title(@page.title)) %>

<% content_for(:head) do %>
  <%= seo_head_tags(
        title: "#{@page.title} — #{site_name}",
        description: @page.seo_description,
        url: page_url(@page.slug)
      ) %>
<% end %>

<article>
  <h1 class="static-page__title"><%= @page.title %></h1>
  <% if @page.content.present? %>
    <div class="static-page__content prose prose-lg prose-gray dark:prose-invert">
      <%= @page.content %>
    </div>
  <% end %>
</article>
