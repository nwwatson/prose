<%= turbo_frame_tag "posts_page_#{page}", target: "_top" do %>
  <% posts.each do |post| %>
    <%= render "posts/post", post: post, snippet: defined?(@snippets) ? @snippets[post.id] : nil %>
  <% end %>

  <% if next_page %>
    <%= turbo_frame_tag "posts_page_#{next_page}", target: "_top" do %>
      <div data-infinite-scroll-target="sentinel">
        <%= link_to t('posts.post_page.load_more'), posts_path(page: next_page, q: query), data: { turbo_frame: "posts_page_#{next_page}" }, class: "hidden" %>
      </div>
      <div data-infinite-scroll-target="loading" class="infinite-scroll-loading">
        <%= t('posts.post_page.loading_more') %>
      </div>
    <% end %>
  <% end %>
<% end %>
