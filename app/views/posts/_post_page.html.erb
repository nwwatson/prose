<%# locals: (posts:, page:, next_page:, next_page_path:, snippets: {}, card: {}) %>
<%# One page of an infinitely scrolled listing. The next page's frame is filled from next_page_path, which the controller answers with the same frame. %>
<%= turbo_frame_tag "posts_page_#{page}", target: "_top" do %>
  <%= render_post_cards posts, snippets: snippets, **card %>

  <% if next_page %>
    <%= turbo_frame_tag "posts_page_#{next_page}", target: "_top" do %>
      <div data-infinite-scroll-target="sentinel">
        <%= link_to t('posts.post_page.load_more'), next_page_path, data: { turbo_frame: "posts_page_#{next_page}" }, class: "hidden" %>
      </div>
      <div data-infinite-scroll-target="loading" class="infinite-scroll-loading">
        <%= t('posts.post_page.loading_more') %>
      </div>
    <% end %>
  <% end %>
<% end %>
