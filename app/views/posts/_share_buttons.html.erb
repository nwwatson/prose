<%
  share_url = post_url(post)
  share_title = post.title
%>
<div class="share-buttons" data-controller="share" data-share-url-value="<%= share_url %>" data-share-title-value="<%= share_title %>">
  <span class="share-buttons__heading"><%= t('posts.show.share.heading') %></span>

  <div class="share-buttons__list">
    <%= link_to "https://twitter.com/intent/tweet?url=#{ERB::Util.url_encode(share_url)}&text=#{ERB::Util.url_encode(share_title)}",
          class: "share-buttons__button", target: "_blank", rel: "noopener noreferrer",
          "aria-label": t("posts.show.share.twitter") do %>
      <svg class="share-buttons__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
      <span class="share-buttons__button-label"><%= t('posts.show.share.twitter') %></span>
    <% end %>

    <%= link_to "https://www.linkedin.com/sharing/share-offsite/?url=#{ERB::Util.url_encode(share_url)}",
          class: "share-buttons__button", target: "_blank", rel: "noopener noreferrer",
          "aria-label": t("posts.show.share.linkedin") do %>
      <svg class="share-buttons__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.446-2.136 2.94v5.666H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z" /></svg>
      <span class="share-buttons__button-label"><%= t('posts.show.share.linkedin') %></span>
    <% end %>

    <%= link_to "https://www.facebook.com/sharer/sharer.php?u=#{ERB::Util.url_encode(share_url)}",
          class: "share-buttons__button", target: "_blank", rel: "noopener noreferrer",
          "aria-label": t("posts.show.share.facebook") do %>
      <svg class="share-buttons__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" /></svg>
      <span class="share-buttons__button-label"><%= t('posts.show.share.facebook') %></span>
    <% end %>

    <%= link_to "mailto:?subject=#{ERB::Util.url_encode(share_title)}&body=#{ERB::Util.url_encode(share_url)}",
          class: "share-buttons__button",
          "aria-label": t("posts.show.share.email") do %>
      <svg class="share-buttons__icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
      <span class="share-buttons__button-label"><%= t('posts.show.share.email') %></span>
    <% end %>

    <span class="share-buttons__copy-wrap">
      <button type="button" class="share-buttons__button" data-action="share#copy" aria-label="<%= t('posts.show.share.copy_link') %>">
        <svg class="share-buttons__icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" /></svg>
        <span class="share-buttons__button-label"><%= t('posts.show.share.copy_link') %></span>
      </button>
      <span class="share-buttons__copy-feedback" data-share-target="copyFeedback" aria-live="polite" hidden><%= t('posts.show.share.copied') %></span>
    </span>

    <button type="button" class="share-buttons__button" data-action="share#native" data-share-target="nativeButton" hidden aria-label="<%= t('posts.show.share.native_share') %>">
      <svg class="share-buttons__icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" /></svg>
      <span class="share-buttons__button-label"><%= t('posts.show.share.native_share') %></span>
    </button>
  </div>
</div>
