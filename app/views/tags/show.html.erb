<% content_for(:title, page_title(@tag.name)) %>

<% content_for(:head) do %>
  <%= seo_head_tags(
        title: page_title(t('tags.show.tagged', name: @tag.name)),
        description: t('tags.show.description', name: @tag.name),
        url: tag_url(slug: @tag.slug)
      ) %>
<% end %>

<div>
  <h1 class="page-heading"><%= t('tags.show.tagged', name: @tag.name) %></h1>
</div>

<div class="post-listing" data-controller="infinite-scroll">
  <%= render "posts/post_page", posts: @posts, page: @page, next_page: @next_page,
        next_page_path: (tag_path(slug: @tag.slug, page: @next_page) if @next_page),
        card: { show_subtitle: false, show_reading_time: false, show_category: false } %>
</div>
