<% content_for(:title, page_title(@tag.name)) %>

<% content_for(:head) do %>
  <%= seo_head_tags(
        title: "Tagged: #{@tag.name} — #{site_name}",
        description: "Posts tagged with #{@tag.name}",
        url: tag_url(@tag, slug: @tag.slug)
      ) %>
<% end %>

<div>
  <h1 class="page-heading"><%= t('tags.show.tagged', name: @tag.name) %></h1>
</div>

<div class="post-listing">
  <% @posts.each do |post| %>
    <%= render "posts/post", post: post, show_subtitle: false, show_reading_time: false, show_category: false %>
  <% end %>
</div>
